# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

mcp_config.json
.vercel
.env*.local

# local resources / non-app assets (marketing decks, docs, one-off scripts)
/resources/

# customer data — bulk-upload spreadsheets carry real names and email addresses
# for thousands of people. Never let these reach the repo.
/ishandata/
*.xlsx
*.xls

# local database backups (contain employee data — never commit)
/backups/
